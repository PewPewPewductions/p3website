# Supabase — leave blank and the site serves the bundled fallback content in
# src/lib/fallback.ts (read-only; the admin page will tell you it is disabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-side only — never prefix this with NEXT_PUBLIC_.
# Used by the admin page to write events and campaign points.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passphrase for /admin. Pick anything; everyone who edits uses the same one.
# This is deliberately simple for the demo. Replace it with real accounts before
# this goes anywhere public.
ADMIN_PASSWORD=
